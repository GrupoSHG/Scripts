# Copia este archivo a ".env" (sin el .example) y completa tus datos reales.
# El archivo ".env" NUNCA se sube a git (ver .gitignore).

# --- SimpleAPI ---
SIMPLEAPI_KEY=1111-1111-1111-1111
RUT_CERTIFICADO=18076720-7
RUT_EMPRESA=76XXXXXXX-X
PASSWORD_CERT=cambia_esto
AMBIENTE=1
# Ruta al certificado digital .pfx en este servidor (nunca en el navegador)
# Localmente: coloca el archivo en secrets/certificado.pfx
# En Render/Railway: usa PFX_BASE64 en vez de esto (ver abajo)
PFX_PATH=./secrets/certificado.pfx

# Alternativa para hosts en la nube (Render/Railway), donde no puedes
# simplemente copiar un archivo: convierte tu .pfx a base64 y pégalo aquí.
# En PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("certificado.pfx")) | Set-Clipboard
# PFX_BASE64=

# --- Manager ERP ---
MANAGER_DOMAIN=https://manager.polchile.cl
MANAGER_BUSINESS_ID=T779354202C
MANAGER_APIKEY=cambia_esto

# --- Casilla de correo dedicada a DTE (solo recibe XML) ---
# Usa una "contraseña de aplicación" de Gmail, no tu clave normal.
DTE_MAIL_IMAP_HOST=imap.gmail.com
DTE_MAIL_IMAP_PORT=993
DTE_MAIL_USER=dte@polchile.cl
DTE_MAIL_PASSWORD=cambia_esto

# --- Boufin (confirmación de transferencias recibidas, Santander) ---
BOUFIN_API_KEY=cambia_esto
SANTANDER_RUT_HOMEBANKING=cambia_esto
SANTANDER_CLAVE_HOMEBANKING=cambia_esto
